/* Reset */
* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

/* Corpo da página */
body {
    font-family: Arial, Helvetica, sans-serif;
    background-color: #f4f4f4;
    color: #333;
}

/* Cabeçalho */
header {
    background: #0b6623;
    color: white;
    text-align: center;
    padding: 25px;
}

header h1 {
    margin-bottom: 10px;
    font-size: 2.5rem;
}

header p {
    font-size: 1.1rem;
}

/* Menu */
nav {
    background: #084d1b;
    padding: 15px;
    text-align: center;
}

nav a {
    color: white;
    text-decoration: none;
    margin: 0 15px;
    font-weight: bold;
    transition: 0.3s;
}

nav a:hover {
    color: #ffd700;
}

/* Banner */
.banner {
    background: url("https://images.unsplash.com/photo-1547347298-4074fc3086f0?auto=format&fit=crop&w=1200&q=80") center center/cover;
    height: 350px;
    display: flex;
    justify-content: center;
    align-items: center;
    color: white;
    text-shadow: 2px 2px 5px black;
    font-size: 2.5rem;
    font-weight: bold;
}

/* Conteúdo */
.container {
    width: 90%;
    max-width: 1100px;
    margin: 30px auto;
}

/* Cartões de notícias */
.post {
    background: white;
    padding: 20px;
    margin-bottom: 25px;
    border-radius: 10px;
    box-shadow: 0 5px 12px rgba(0, 0, 0, 0.1);
}

.post h2 {
    color: #0b6623;
    margin-bottom: 10px;
}

.post p {
    line-height: 1.6;
}

/* Botão */
.btn {
    display: inline-block;
    margin-top: 15px;
    background: #0b6623;
    color: white;
    text-decoration: none;
    padding: 10px 18px;
    border-radius: 5px;
    transition: 0.3s;
}

.btn:hover {
    background: #128437;
}

/* Rodapé */
footer {
    background: #0b6623;
    color: white;
    text-align: center;
    padding: 20px;
    margin-top: 40px;
}

/* Responsividade */
@media (max-width: 768px) {
    .banner {
        height: 220px;
        font-size: 1.8rem;
        text-align: center;
        padding: 20px;
    }

    nav a {
        display: inline-block;
        margin: 8px;
    }

    header h1 {
        font-size: 2rem;
    }
}
